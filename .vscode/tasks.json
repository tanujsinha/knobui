{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ESP-IDF: Build",
            "type": "shell",
            "command": "${workspaceFolder}/build.sh",
            "args": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$espIdf"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "ESP-IDF: Clean",
            "type": "shell",
            "command": "export PATH='/opt/homebrew/opt/python@3.11/libexec/bin:$PATH' && source ~/esp/esp-idf/export.sh > /dev/null 2>&1 && export PATH="$HOME/.espressif/python_env/idf5.3_py3.9_env/bin:$PATH" && idf.py fullclean",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "ESP-IDF: Flash",
            "type": "shell",
            "command": "${workspaceFolder}/flash.sh",
            "args": [],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "ESP-IDF: Flash Low Baud",
            "type": "shell",
            "command": "${workspaceFolder}/flash.sh /dev/cu.usbmodem1101 115200",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "ESP-IDF: Build and Flash",
            "type": "shell",
            "command": "${workspaceFolder}/build-flash.sh",
            "args": [],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": ["$espIdf"]
        },
        {
            "label": "ESP-IDF: Monitor",
            "type": "shell",
            "command": "export PATH='/opt/homebrew/opt/python@3.11/libexec/bin:$PATH' && source ~/esp/esp-idf/export.sh > /dev/null 2>&1 && export PATH="$HOME/.espressif/python_env/idf5.3_py3.9_env/bin:$PATH" && idf.py -p /dev/cu.usbmodem1101 monitor",
            "group": "test",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "ESP-IDF: Flash and Monitor",
            "type": "shell",
            "command": "${workspaceFolder}/build-flash.sh && export PATH='/opt/homebrew/opt/python@3.11/libexec/bin:$PATH' && source ~/esp/esp-idf/export.sh > /dev/null 2>&1 && export PATH="$HOME/.espressif/python_env/idf5.3_py3.9_env/bin:$PATH" && idf.py -p /dev/cu.usbmodem1101 monitor",
            "group": "build",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "ESP-IDF: Set Target ESP32-S3",
            "type": "shell",
            "command": "export PATH='/opt/homebrew/opt/python@3.11/libexec/bin:$PATH' && source ~/esp/esp-idf/export.sh > /dev/null 2>&1 && export PATH="$HOME/.espressif/python_env/idf5.3_py3.9_env/bin:$PATH" && idf.py set-target esp32s3",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "ESP-IDF: Menuconfig",
            "type": "shell",
            "command": "export PATH='/opt/homebrew/opt/python@3.11/libexec/bin:$PATH' && source ~/esp/esp-idf/export.sh > /dev/null 2>&1 && export PATH="$HOME/.espressif/python_env/idf5.3_py3.9_env/bin:$PATH" && idf.py menuconfig",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Git: Quick Update",
            "type": "shell",
            "command": "msg=$(read -p 'Enter commit message: ' m && echo $m); if [ -n \"$msg\" ]; then git add . && git commit -m \"$msg - $(date '+%Y-%m-%d %H:%M')\" && git push && echo 'Updated GitHub!'; else echo 'No message provided'; fi",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Git: Status",
            "type": "shell",
            "command": "git",
            "args": ["status", "--short"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}